function Assets.uri(value)
 if type(value)~="string" then return "" end
 if value:match("^%d+$") then return "rbxassetid://"..value end
 if value:match("^rbxassetid://%d+$") then return value end
 return ""
end
function Assets.theme(category,id)
 return Assets.Aliases[category] and Assets.Aliases[category][id] or id or "DefaultClassic"
end
function Assets.resolve(category,id,piece,component)
 local theme=Assets.theme(category,id)
 local entry=Assets.Themes[theme] and Assets.Themes[theme][piece]
 local value=entry and entry[category]
 if component then value=type(value)=="table" and value[component] or nil end
 return Assets.uri(value),theme
end
return Assets
