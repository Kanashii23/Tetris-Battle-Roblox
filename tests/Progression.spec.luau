local P=require("../src/shared/Progression")
local C=require("../src/server/GameConfig")
local Catalog=require("../src/shared/Catalog")
local now=1791590400
local function fresh() return P.refresh(P.default(now),now,C) end
local n=0
local function test(name,fn) fn(); n+=1; print("PASS "..name) end
local function result(id,outcome)
	return {id=id,outcome=outcome,lines=4,spins=1,tetrises=1,perfect=0,sent=4,kos=1,startTier=1,startRating=1000,opponentRating=1000,rewardEligible=true,opponentId=99,day=math.floor(now/86400),timestamp=now}
end
test("offline energy and normal/bonus caps",function()
	local d=fresh(); d.Energy.Current=3; P.refresh(d,now+1300,C); assert(d.Energy.Current==5 and P.nextEnergy(d,now+1300,C)==500)
	P.refresh(d,now+10000,C); assert(d.Energy.Current==10); d.Energy.Current=20; P.refresh(d,now+10000,C); assert(d.Energy.Current==20)
end)
test("rank promotion, demotion, Rookie floor and Master rating",function()
	local d=fresh(); d.Rank.Stars=2; P.settle(d,result("a","Win"),C); assert(d.Rank.Tier==2 and d.Rank.Stars==0 and d.Cash==50)
	P.settle(d,result("b","Lose"),C); assert(d.Rank.Tier==1 and d.Rank.Stars==2)
	d.Rank.Stars=0; P.settle(d,result("c","Lose"),C); assert(d.Rank.Stars==0)
	d.Rank.Tier=7; local before=d.Rank.Rating; P.settle(d,result("d","Win"),C); assert(d.Rank.Tier==7 and d.Rank.Rating>before)
end)
test("match reward and refund idempotence",function()
	local d=fresh(); d.Reservations.a={}; d.Energy.Current=9
	assert(P.settle(d,result("a","Win"),C)); assert(not P.settle(d,result("a","Win"),C)); assert(d.Cash==50 and d.Stats.Matches==1 and not d.Reservations.a)
	d.Reservations.b={}; assert(P.settle(d,{id="b:refund",roomId="b",kind="Refund"},C)); assert(d.Energy.Current==10)
	P.settle(d,{id="b:refund",roomId="b",kind="Refund"},C); assert(d.Energy.Current==10)
end)
test("quest claims once and UTC resets",function()
	local d=fresh(); P.questProgress(d,{Lines=30,TSpins=2}); assert(P.claimQuest(d,"Daily","lines",C)); assert(d.Cash==75); assert(not P.claimQuest(d,"Daily","lines",C))
	assert(P.claimQuest(d,"Daily","spin",C)); assert(d.Energy.Current==11)
	P.refresh(d,now+86400,C); assert(not d.Quests.Daily.Claimed.lines and (d.Quests.Daily.Progress.lines or 0)==0)
end)
test("login preserves earned cycle after missed days",function()
	local d=fresh(); assert(P.login(d,now,C)); assert(not P.login(d,now,C)); assert(P.login(d,now+5*86400,C)); assert(d.Login.Index==2 and d.Cash==75)
end)
test("cosmetic purchase, equip, ownership, insufficient funds",function()
	local d=fresh(); local item=Catalog.list("BrickSkins")[2]; assert(not P.purchase(d,item.Category,item.Id,Catalog,false)); d.Cash=item.Price+1000
	assert(P.purchase(d,item.Category,item.Id,Catalog,false)); local cash=d.Cash; assert(not P.purchase(d,item.Category,item.Id,Catalog,false)); assert(d.Cash==cash)
	assert(P.equip(d,item.Category,item.Id,Catalog,false)); assert(d.Equipped.BrickSkin==item.Id)
end)
test("seasons preserve Cash/inventory and reward only once",function()
	local d=fresh(); d.Cash=100; d.Season.Wins=5
	P.refresh(d,now+C.SeasonDays*86400,C); assert(d.Cash==150 and #d.Season.History==1 and d.Inventory.Badges.Season1)
	P.refresh(d,now+C.SeasonDays*86400,C); assert(d.Cash==150)
end)
test("anti-farming suppresses rank, Cash and competitive wins",function()
	local d=fresh(); local r=result("x","Win"); r.rewardEligible=false; P.settle(d,r,C); assert(d.Cash==0 and d.Rank.Stars==0 and d.Stats.QualifiedWins==0)
end)
test("data migration and invalid equipped defaults",function()
	local d=P.validate({Cash=-20,Energy={Current=-1},Rank={Tier=999,Stars=0,Rating=0},Equipped={BrickSkin="invalid"}},now,Catalog)
	assert(d.Cash==0 and d.Energy.Current==0 and d.Rank.Tier==7 and d.Equipped.BrickSkin=="Default")
end)
test("social Energy requires unique verified result and daily limits",function()
	local d=fresh(); P.settle(d,{id="social:1",kind="Social",friendId=1},C); assert(d.Energy.Current==11 and d.SocialRewards.Count==1)
	P.settle(d,{id="social:1",kind="Social",friendId=1},C); assert(d.Energy.Current==11)
	P.settle(d,{id="social:2",kind="Social",friendId=2},C); P.settle(d,{id="social:3",kind="Social",friendId=3},C); assert(d.Energy.Current==12 and d.SocialRewards.Count==2)
end)
print(n.." total progression tests passed")
